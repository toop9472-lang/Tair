{
  "expo": {
    "name": "طير",
    "slug": "saqr-app",
    "version": "8.6.5",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#c8fce6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-iap",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "kotlinVersion": "2.0.21",
            "extraProguardRules": "-keep class ** { *; }",
            "enableProguardInReleaseBuilds": false,
            "packagingOptions": {
              "jniLibs": {
                "useLegacyPackaging": true,
                "pageSize": 16384
              }
            },
            "ndkVersion": "28.0.12674087"
          },
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5132559433385403~1073385732",
          "iosAppId": "ca-app-pub-5132559433385403~1073385732"
        }
      ],
      "expo-font",
      [
        "react-native-edge-to-edge",
        {
          "android": {
            "parentTheme": "EdgeToEdge"
          }
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-asset",
      "expo-tracking-transparency",
      "./plugins/withFmtPodfileFix.js"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saqr.rewards",
      "buildNumber": "216",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "يستخدم التطبيق الكاميرا لتحميل الصور",
        "NSPhotoLibraryUsageDescription": "يستخدم التطبيق مكتبة الصور لاختيار ورفع مقاطع الريلز",
        "NSPhotoLibraryAddUsageDescription": "يحتاج التطبيق صلاحية إضافة الوسائط عند مشاركة أو حفظ المحتوى",
        "NSUserTrackingUsageDescription": "يستخدم هذا التطبيق معرّف الإعلان لتقديم إعلانات مخصصة",
        "GADApplicationIdentifier": "ca-app-pub-5132559433385403~1073385732",
        "UIRequiresFullScreen": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "saqr"
            ]
          }
        ],
        "SKAdNetworkItems": [
          {
            "SKAdNetworkIdentifier": "cstr6suwn9.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "4fzdc2evr5.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "2fnua5tdw4.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "ydx93a7ass.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "5a6flpkh64.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "p78axxw29g.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "v72qych5uu.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "c6k4g5qg8m.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "s39g8k73mm.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "3qy4746246.skadnetwork"
          }
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B3D2F",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "package": "com.saqr.rewards",
      "versionCode": 216,
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "saqr",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            { "scheme": "saqr", "host": "listing" },
            { "scheme": "saqr", "host": "auction" },
            { "scheme": "saqr", "host": "story" },
            { "scheme": "saqr", "host": "trip" },
            { "scheme": "saqr", "host": "store" }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "saqr-ui-sync.emergent.host",
              "pathPrefix": "/share"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "AD_ID"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/logo_saqr.png"
    },
    "owner": "ziyad333",
    "extra": {
      "eas": {
        "projectId": "2a08ac90-1772-4377-bf99-af5d2357db30"
      },
      "admob": {
        "iosRewardedAdUnitId": "ca-app-pub-5132559433385403/2999033852",
        "androidRewardedAdUnitId": "ca-app-pub-5132559433385403/3389052725"
      }
    },
    "scheme": "saqr"
  }
}