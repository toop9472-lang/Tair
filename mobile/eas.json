{
  "cli": {
    "version": ">= 12.8.2",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6"
      },
      "android": {
        "image": "latest"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "ios": {
        "simulator": true,
        "image": "macos-tahoe-26.5-xcode-26.6"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease",
        "image": "latest"
      },
      "ios": {
        "distribution": "store",
        "credentialsSource": "remote",
        "image": "macos-tahoe-26.5-xcode-26.6"
      },
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "1",
        "EX_UPDATES_NATIVE_DEBUG": "0",
        "EXPO_PUBLIC_BACKEND_URL": "https://saqr-ui-sync.emergent.host"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6758868843",
        "ascApiKeyIssuerId": "2b3dfd1a-b44d-4cf7-94b8-6f10d64b9567",
        "ascApiKeyId": "L598DUD53L",
        "ascApiKeyPath": "./certificates/AuthKey_L598DUD53L.p8"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
